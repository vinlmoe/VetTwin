# Service systemd du relais de salle (Raspberry Pi OS, Debian, Ubuntu).
# Installer : sudo cp salle/vettwins-relay.service /etc/systemd/system/
#             (remplacer UTILISATEUR et le chemin du dépôt, puis éventuellement la clé)
#             sudo systemctl daemon-reload && sudo systemctl enable --now vettwins-relay
[Unit]
Description=Relais VetTwins (salle de simulation)
After=network-online.target
Wants=network-online.target

[Service]
User=UTILISATEUR
WorkingDirectory=/home/UTILISATEUR/srv/VetTwin/vetsim-kit
ExecStart=/usr/bin/python3 -I salle/relay.py --web web --host 0.0.0.0 --port 8765
# Clé partagée (facultatif) : la même dans VetTwinConfig.h et dans l'adresse des pages (&key=)
# Environment=VETTWIN_KEY=changer-moi
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
