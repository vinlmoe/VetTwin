{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "auscultation.schema.json",
 "title": "Configuration du module auscultation (synthèse du PCG)",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "version",
  "defaults",
  "presets",
  "events",
  "sound",
  "s1",
  "s2",
  "s3",
  "murmur",
  "variability",
  "background",
  "grade",
  "sites"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0.0"
  },
  "id": {
   "const": "auscultation"
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "description": {
   "type": "object"
  },
  "defaults": {
   "type": "object",
   "required": [
    "fs",
    "duration_s",
    "resp_hz",
    "first_beat_s",
    "end_margin_s",
    "source",
    "evidence",
    "calibre_sur"
   ],
   "properties": {
    "fs": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "duration_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "resp_hz": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "first_beat_s": {
     "type": "number"
    },
    "end_margin_s": {
     "type": "number"
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "presets": {
   "type": "object",
   "required": [
    "rest_hr",
    "source",
    "evidence",
    "calibre_sur"
   ],
   "properties": {
    "rest_hr": {
     "type": "number",
     "exclusiveMinimum": 0
