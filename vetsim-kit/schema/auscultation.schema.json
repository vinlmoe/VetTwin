    "guard_systole_frac": {
     "type": "number"
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "sound": {
   "type": "object",
   "required": [
    "components",
    "attack_tau_s",
    "source",
    "evidence",
    "calibre_sur"
   ],
   "properties": {
    "components": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
     }
    },
    "attack_tau_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
