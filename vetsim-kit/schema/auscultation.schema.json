    "filter_order": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8
    },
    "amp": {
     "type": "number"
    },
    "flow_threshold": {
     "type": "number"
    },
    "jitter": {
     "type": "array",
     "items": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "minItems": 2,
     "maxItems": 2
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "variability": {
   "type": "object",
   "required": [
    "gain_lognormal_sd",
    "resp_modulation",
    "source",
    "evidence",
    "calibre_sur"
   ],
   "properties": {
    "gain_lognormal_sd": {
     "type": "number",
