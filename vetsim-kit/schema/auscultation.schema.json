    "la_threshold_mmhg": {
     "type": "number"
    },
    "amp": {
     "type": "number"
    },
    "delay_s": {
     "type": "number"
    },
    "audible_threshold": {
     "type": "number"
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "murmur": {
   "type": "object",
   "required": [
    "band_hz",
    "filter_order",
    "amp",
