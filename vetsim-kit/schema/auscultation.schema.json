     "type": "number",
     "exclusiveMinimum": 0
    },
    "dpdt_ref": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "base_amp": {
     "type": "number"
    },
    "cap": {
     "type": "number"
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
