    "min_flow_ml_s": {
     "type": "number"
    },
    "max": {
     "type": "integer",
     "minimum": 0,
     "maximum": 6
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "sites": {
   "type": "object",
   "required": [
    "base"
   ],
   "additionalProperties": {
    "type": "object",
    "required": [
     "s1_gain",
     "s2_gain",
     "murmur_gain",
     "source",
     "evidence",
     "calibre_sur"
    ],
    "properties": {
     "s1_gain": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "s2_gain": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "murmur_gain": {
      "type": "number",
      "minimum": 0
     },
     "source": {
      "type": "string"
     },
     "evidence": {
      "enum": [
       "A",
       "B",
       "C",
       "D"
      ]
     },
     "calibre_sur": {
      "type": "string"
     }
    }
   }
  }
 }
}