    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "events": {
   "type": "object",
   "required": [
    "guard_systole_frac",
    "source",
    "evidence",
    "calibre_sur"
   ],
