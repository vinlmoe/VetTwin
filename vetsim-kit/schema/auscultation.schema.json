    "swell_phase",
    "source",
    "evidence",
    "calibre_sur"
   ],
   "properties": {
    "band_hz": {
     "type": "array",
     "items": {
      "type": "number",
      "exclusiveMinimum": 0
     },
     "minItems": 2,
     "maxItems": 2
    },
    "filter_order": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8
    },
    "amp": {
     "type": "number"
    },
    "swell_base": {
     "type": "number"
    },
    "swell_amp": {
     "type": "number"
    },
    "swell_phase": {
     "type": "number"
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "grade": {
   "type": "object",
   "required": [
    "thresholds_ml_s",
    "min_flow_ml_s",
    "max",
    "source",
    "evidence",
    "calibre_sur"
   ],
   "properties": {
    "thresholds_ml_s": {
     "type": "array",
     "items": {
      "type": "number"
     },
     "minItems": 1
