    "f0_pulmonic_hz": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "tau_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "duration_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "dp_ref": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "base_amp": {
     "type": "number"
    },
    "cap": {
     "type": "number"
    },
    "aortic_insp_drop": {
     "type": "number"
    },
    "pulmonic_base": {
     "type": "number"
    },
    "pulmonic_insp": {
     "type": "number"
    },
    "split_base_s": {
     "type": "number"
    },
    "split_insp_s": {
     "type": "number"
    },
    "systole_rr_exp": {
     "type": "number"
    },
    "gain_rr_exp": {
     "type": "number"
    },
    "source": {
     "type": "string"
    },
    "evidence": {
     "enum": [
      "A",
      "B",
      "C",
      "D"
     ]
    },
    "calibre_sur": {
     "type": "string"
    }
   }
  },
  "s3": {
   "type": "object",
   "required": [
    "la_threshold_mmhg",
    "f0_hz",
    "tau_s",
    "duration_s",
