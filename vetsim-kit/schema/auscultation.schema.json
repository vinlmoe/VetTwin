    "tau_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "duration_s": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "q_ref": {
     "type": "number",
     "exclusiveMinimum": 0
