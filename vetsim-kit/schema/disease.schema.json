{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "disease.schema.json",
 "title": "Module maladie",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "version",
  "name",
  "evidence",
  "severity",
  "effects"
 ],
 "properties": {
  "schema_version": {
   "const": "1.0.0"
  },
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9_]+$"
  },
  "version": {
   "type": "string",
   "pattern": "^\\d+\\.\\d+\\.\\d+$"
  },
  "species": {
   "type": "array",
   "items": {
    "enum": [
     "dog",
     "cat"
    ]
   }
  },
  "license": {
   "type": "string"
  },
  "name": {
   "type": "object",
   "properties": {
    "fr": {},
    "en": {}
   }
  },
  "description": {
   "type": "object",
   "properties": {
    "fr": {},
    "en": {}
   }
  },
  "evidence": {
   "enum": [
    "A",
    "B",
    "C",
    "D"
   ],
   "description": "A: calé sur mesures publiées; B: bornes/critères publiés; C: plausibilité à partir d'intervalles publiés; D: placeholder pédagogique"
  },
  "severity": {
   "type": "object",
   "required": [
    "stages",
    "prior"
   ],
   "properties": {
    "stages": {
     "type": "object",
     "additionalProperties": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     }
    },
    "prior": {
     "type": "object",
     "additionalProperties": {
      "type": "number",
      "minimum": 0
     }
    }
   }
  },
  "draws": {
   "type": "object",
   "additionalProperties": {
    "oneOf": [
     {
      "type": "object",
      "required": [
       "dist",
       "sd"
      ],
      "properties": {
       "dist": {
        "const": "lognormal_mean1"
       },
       "sd": {
        "type": "number",
        "minimum": 0
       }
      }
     },
     {
      "type": "object",
      "required": [
       "dist",
       "p"
      ],
      "properties": {
       "dist": {
        "const": "bernoulli"
       },
       "p": {
        "$ref": "expr.schema.json"
       }
      }
     }
    ]
   }
  },
  "let": {
   "type": "object",
   "additionalProperties": {
    "$ref": "expr.schema.json"
   }
  },
  "effects": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "param",
     "op",
     "expr"
    ],
    "additionalProperties": false,
    "properties": {
     "param": {
      "type": "string"
     },
     "op": {
      "enum": [
       "mul",
       "add"
      ]
     },
     "expr": {
      "$ref": "expr.schema.json"
     },
     "when": {
      "$ref": "expr.schema.json"
     },
     "clamp": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     }
    }
   },
   "minItems": 1
  },
  "meta_flags": {
   "type": "object"
  },
  "targets": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "stage",
     "var",
     "range",
     "source",
     "kind"
    ],
    "properties": {
     "stage": {
      "type": "string"
     },
     "var": {
      "type": "string"
     },
     "range": {
      "type": "array",
      "items": {
       "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
     },
     "unit": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "published_threshold",
       "plausibility",
       "measured"
      ]
     }
    }
   }
  },
  "refs": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "presentation": {
   "type": "object"
  }
 }
}