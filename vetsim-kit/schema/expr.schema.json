{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "expr.schema.json",
 "title": "Expression du DSL",
 "description": "Nombre, nom de variable, ou objet à une seule clé {op: argument(s)}. Voir docs/DSL.md.",
 "oneOf": [
  {
   "type": "number"
  },
  {
   "type": "boolean"
  },
  {
   "type": "string"
  },
  {
   "type": "object",
   "minProperties": 1,
   "maxProperties": 1,
   "propertyNames": {
    "enum": [
     "add",
     "sub",
     "mul",
     "div",
     "pow",
     "exp",
     "log",
     "neg",
     "abs",
     "min",
     "max",
     "clip",
     "if",
     "lt",
     "le",
     "gt",
     "ge",
     "not",
     "and",
     "or"
    ]
   },
   "additionalProperties": {
    "oneOf": [
     {
      "$ref": "#"
     },
     {
      "type": "array",
      "items": {
       "$ref": "#"
      }
     }
    ]
   }
  }
 ]
}