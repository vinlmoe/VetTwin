{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "patient.schema.json",
 "title": "Patient sain de référence",
 "type": "object",
 "required": [
  "schema_version",
  "id",
  "version",
  "reference_bw_kg",
  "params"
 ],
 "properties": {
  "reference_bw_kg": {
   "const": 20.0
  },
  "params": {
   "type": "object",
   "additionalProperties": {
    "$ref": "expr.schema.json"
   }
  },
  "interindividual_variability": {
   "type": "object",
   "additionalProperties": {
    "type": "object",
    "required": [
     "dist",
     "sd"
    ],
    "properties": {
     "dist": {
      "const": "lognormal_mean1"
     },
     "sd": {
      "type": "number"
     }
    }
   }
  }
 }
}